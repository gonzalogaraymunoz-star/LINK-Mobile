{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/health.js" },
    { "src": "/mcp", "dest": "/api/mcp.js" },
    { "src": "/favicon.ico", "dest": "/api/index.js" },
    { "src": "/favicon.png", "dest": "/api/index.js" }
  ]
}
